<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Nullable>enable</Nullable>

    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAOTAnalyzer>true</EnableAOTAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>

    <!-- Treat warnings as errors for strict validation. This includes the trim and AOT warnings
         from the native compiler (ILC), so FAnsiSql code that is not AOT-safe fails the publish -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../src/FAnsi.Core/FAnsi.Core.csproj" />
    <ProjectReference Include="../../../src/FAnsi.Sqlite/FAnsi.Sqlite.csproj" />
  </ItemGroup>
</Project>
