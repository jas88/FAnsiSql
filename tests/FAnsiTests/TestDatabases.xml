<TestDatabases>
	<Settings>
		<AllowDatabaseCreation>True</AllowDatabaseCreation>
		<TestScratchDatabase>FAnsiTests</TestScratchDatabase>
	</Settings>
	<TestDatabase>
		<DatabaseType>MicrosoftSQLServer</DatabaseType>
		<ConnectionString>Data Source=(localdb)\MSSQLLocalDB</ConnectionString>
	</TestDatabase>
	<TestDatabase>
		<DatabaseType>MySql</DatabaseType>
		<ConnectionString>server=127.0.0.1;Uid=root;Pwd=root;AllowPublicKeyRetrieval=True;ConvertZeroDateTime=true</ConnectionString>
	</TestDatabase>
	<TestDatabase>
		<DatabaseType>Sqlite</DatabaseType>
		<!-- A file in the working directory of the tests (their output directory). An in-memory database does not
		     outlive its connection, and FAnsi opens a connection for each operation -->
		<ConnectionString>Data Source=fansitests.db</ConnectionString>
	</TestDatabase>
